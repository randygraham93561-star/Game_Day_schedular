<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_game_card_fill">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/text_game_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#424242"
                android:textSize="12sp"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@android:drawable/ic_menu_recent_history"
                app:drawableTint="#424242"
                tools:text="2026-06-06 10:00 PM" />

            <TextView
                android:id="@+id/text_game_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="#616161"
                android:textSize="12sp"
                tools:text="#32" />
        </RelativeLayout>

        <TextView
            android:id="@+id/text_teams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="14UB2 vs 14UB4" />

        <TextView
            android:id="@+id/text_field"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#424242"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Field 7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- HR Slot -->
            <TextView
                android:id="@+id/btn_assign_hr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_slot_button"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_person_outline"
                tools:text="Assign Head Ref" />

            <!-- AR1 Slot -->
            <TextView
                android:id="@+id/btn_assign_ar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_slot_button"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_person_outline"
                tools:text="Assign Assistant Ref" />

            <!-- AR2 Slot -->
            <TextView
                android:id="@+id/btn_assign_ar2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_slot_button"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_person_outline"
                tools:text="Assign Assistant Ref" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
